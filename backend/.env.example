# ── Required ────────────────────────────────────────────────────────────────
# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Signing key for login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when ENVIRONMENT=production; otherwise an ephemeral key is used (logins reset on restart).
JWT_SECRET=

# development | production
ENVIRONMENT=development

# Comma-separated frontend URLs (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ── Admin ───────────────────────────────────────────────────────────────────
# Accounts with these emails get the admin dashboard (comma-separated).
ADMIN_EMAILS=
# Optional header key (X-Admin-Key) for scripted access to /admin/*. Leave empty to disable.
ADMIN_KEY=

# ── Quotas ──────────────────────────────────────────────────────────────────
DEFAULT_MONTHLY_TOKEN_LIMIT=50000
ANON_QUERY_LIMIT=5
ANON_WINDOW_HOURS=24

# ── LLM ─────────────────────────────────────────────────────────────────────
LLM_MODEL=llama-3.3-70b-versatile
# Model for background conversation summaries (defaults to LLM_MODEL)
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30
SQL_REPAIR_ATTEMPTS=1

# ── Conversation memory ─────────────────────────────────────────────────────
HOT_WINDOW_MESSAGES=10
SUMMARIZE_BATCH_MESSAGES=6
# Optional Redis cache for session context (SQLite is always the source of truth)
REDIS_URL=

# ── Storage (defaults live next to this file) ───────────────────────────────
# CRICKET_DB_PATH=./cricket.db
# USERS_DB_PATH=./users.db
